{
 "name": "Kit · Sub · Errores",
 "nodes": [
  {
   "parameters": {},
   "id": "trigger-error",
   "name": "Error Trigger",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [0, 0]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_TOKEN + '/sendMessage' }}",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ chat_id: $env.ALERT_CHAT_ID, text: '⚠️ Flujo fallido: ' + ($json.workflow.name || '?') + ' · ' + (($json.execution.error && $json.execution.error.message) || 'error') }) }}",
    "options": { "timeout": 15000 }
   },
   "id": "aviso",
   "name": "Aviso error",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.5,
   "position": [260, 0],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 2000,
   "onError": "continueRegularOutput"
  }
 ],
 "connections": {
  "Error Trigger": { "main": [[{ "node": "Aviso error", "type": "main", "index": 0 }]] }
 },
 "settings": { "executionOrder": "v1" }
}
